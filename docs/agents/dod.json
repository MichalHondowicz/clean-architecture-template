{
  "implementerAgent": "mattpocock-skills:implementer",
  "environmentChecks": [
    {
      "name": "docker",
      "run": "docker info",
      "start": "Start-Process 'C:\\Program Files\\Docker\\Docker\\Docker Desktop.exe'"
    }
  ],
  "commands": [
    { "name": "build", "run": "dotnet build CleanArchitecture.slnx" },
    { "name": "test", "run": "dotnet test CleanArchitecture.slnx --no-build" }
  ],
  "protectedPaths": [
    ".editorconfig",
    "Directory.Build.props",
    "AGENTS.md",
    "CLAUDE.md",
    "docs/adr/**",
    "docs/agents/**",
    ".claude/**",
    "tests/ArchitectureTests/**",
    "tests/HookTests/**"
  ],
  "quota": {
    "weeklyPercent": 80,
    "fiveHourPercent": 90
  }
}
